#!/usr/bin/env bash
# Runs the name check over the ref names, the annotated tag messages, and the
# commits of every push. Then it runs `make preflight` before a push that
# updates refs/heads/main or any tag, since those are the pushes CI and the
# release workflow act on. Feature-branch pushes and ref deletions skip
# preflight, and a deletion skips the name check too. Enable the hook with
# `make hooks`; `git push --no-verify` bypasses it.
#
# The commits a push adds are measured against what the remote already has.
# For a ref the remote holds, that is the range from the remote's commit to
# the pushed one. For a new ref, or when the remote's commit is unknown here,
# it is everything reachable from the pushed commit and not from the
# remote's tracking refs, which is the whole history when there are none.
#
# OCFP_NAMECHECK names another program to run in place of the name check,
# which the hook tests use. The hook says so on standard error when set.
#
# Preflight tests the checkout, not the pushed commit, so the hook refuses
# a gated push unless the pushed sha is HEAD and no tracked file has
# uncommitted changes. Untracked files do not count.
set -euo pipefail

remote=${1:-}

if [ -n "${OCFP_NAMECHECK:-}" ]; then
  echo "pre-push: OCFP_NAMECHECK replaces the real name check" >&2
fi

# The checker never reads the hook's input, which holds the other refs.
namecheck() {
  if [ -n "${OCFP_NAMECHECK:-}" ]; then
    "$OCFP_NAMECHECK" "$@" </dev/null
  else
    go run ./scripts/namecheck "$@" </dev/null
  fi
}

# Work from the top of the worktree, so the checker finds its sources and the
# repository's own settings.
cd "$(git rev-parse --show-toplevel)"

# tracking lists the remote's tracking refs as exclusions for rev-list.
tracking=$(git for-each-ref --format='^%(refname)' "refs/remotes/$remote/" 2>/dev/null | tr '\n' ' ' | sed 's/ $//' || true)

gated_shas=()

# git feeds one line per ref: <local ref> <local sha> <remote ref> <remote sha>
while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ "$local_sha" =~ ^0+$ ]]; then
    continue # deleting a remote ref; the all-zero sha is 40 or 64 digits long
  fi

  namecheck --names "$local_ref" "$remote_ref"

  # An annotated tag has a tagger line and a message of its own, which the
  # commit scan below never reads. The object decides, not the ref name,
  # because a tag object can be pushed by its hash under any name.
  if [ "$(git --no-replace-objects cat-file -t "$local_sha" 2>/dev/null || true)" = tag ]; then
    namecheck --tag "$remote_ref" "$local_sha"
  fi

  if ! [[ "$remote_sha" =~ ^0+$ ]] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    range="$remote_sha..$local_sha"
  else
    if ! [[ "$remote_sha" =~ ^0+$ ]]; then
      echo "pre-push: the remote holds commits this clone does not; fetch first. Checking everything its tracking refs lack." >&2
    fi
    range="$local_sha${tracking:+ $tracking}"
  fi
  namecheck --range "$range"

  case "$remote_ref" in
    refs/heads/main | refs/tags/*) gated_shas+=("$local_sha") ;;
  esac
done

if [ "${#gated_shas[@]}" -eq 0 ]; then
  exit 0
fi

# git exports GIT_DIR to a hook run from a linked worktree, and
# core.hooksPath points every worktree at the main checkout's hooks. Drop
# git's variables so git finds the repository from the working directory,
# and so preflight's own git commands never act on this repository, then
# move to the top of the worktree being pushed.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_COMMON_DIR
cd "$(git rev-parse --show-toplevel)"

refuse() {
  echo "pre-push: preflight can only vouch for HEAD with a clean tree, and $1." >&2
  echo "pre-push: check out the commit you are pushing and commit or stash tracked changes, or use git push --no-verify to override." >&2
  exit 1
}

head_sha="$(git rev-parse HEAD)"
for sha in "${gated_shas[@]}"; do
  # An annotated tag arrives as the tag object's sha, so compare the
  # commit it points at. A sha that names no commit stays as it is and
  # is refused below.
  commit_sha="$(git rev-parse --verify --quiet "${sha}^{commit}" || echo "$sha")"
  if [ "$commit_sha" != "$head_sha" ]; then
    refuse "this push includes ${sha}, which is not HEAD (${head_sha})"
  fi
done
if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
  refuse "tracked files have uncommitted changes"
fi

echo "pre-push: running make preflight (skip with git push --no-verify)" >&2
if ! make preflight; then
  echo "pre-push: preflight failed; push aborted. Fix the failure, or use git push --no-verify to override." >&2
  exit 1
fi
