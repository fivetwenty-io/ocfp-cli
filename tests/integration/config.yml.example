# Integration test configuration — copy to config.yml and populate before running.
# This file is never loaded automatically; it must be referenced explicitly via
# the INTEGRATION_CONFIG environment variable or the cfgloader.LoadConfig call.
#
# Rename this file to config.yml (git-ignored) or any other path, then:
#   export INTEGRATION_CONFIG=/path/to/config.yml

# ---------------------------------------------------------------------------
# Top-level (required)
# ---------------------------------------------------------------------------

# Path to BOSH vars file used for tier-2 director deployment tests.
bosh_vars: manifests/bosh/vars.yml

# Path to BOSH credentials file (generated by 'genesis deploy').
bosh_creds: manifests/bosh/creds.yml

# Path to CF vars file used for tier-3 smoke tests.
cf_vars: manifests/cf/vars.yml

# ---------------------------------------------------------------------------
# Tier flags — set each to true to activate that test tier.
# ---------------------------------------------------------------------------
tiers:
  lifecycle: true   # Tier 1: 16-step CPI lifecycle (requires a live PVE host)
  bosh: false       # Tier 2: BOSH director deployment
  cf: false         # Tier 3: Cloud Foundry smoke tests
  light: false      # Tier 4: Lightweight sanity checks

# ---------------------------------------------------------------------------
# Tier 1 — CPI lifecycle parameters (required when tiers.lifecycle: true)
# ---------------------------------------------------------------------------
tier1:
  # VMID range reserved for lifecycle test VMs.
  # Must not overlap with production VMIDs on the cluster.
  vmid_range_start: 900
  vmid_range_end: 999

  # Network settings for the test VM.
  network_ip: 192.168.1.250
  network_range: 192.168.1.0/24
  network_gateway: 192.168.1.1
  network_bridge: vmbr0
  network_dns:
    - 8.8.8.8

  # VM sizing.
  vm_cores: 1
  vm_memory_mib: 1024

  # Persistent disk size (MiB) created during the lifecycle test.
  disk_size_mib: 1024

  # Absolute path to the BOSH stemcell tarball (.tgz) to use.
  stemcell_path: /tmp/bosh-stemcell.tgz

  # Set to true to skip the snapshot-detach step (some PVE storage types do
  # not support detaching snapshots; this bypasses the assertion).
  snapshot_detach_bypass: false

  # Network test mode configuration.
  # modes: "off" disables network tests; "sdn" or "bridge" runs the
  # corresponding network create/delete steps; "auto" probes both.
  network_test:
    modes: "off"
    sdn:
      zone: ""          # SDN zone name (required when modes includes sdn)
      zone_type: simple # Zone type: simple | vlan | vxlan | evpn
      vnet: itvnet      # Virtual network name within the zone
      range: 10.250.0.0/24
      gateway: 10.250.0.1
      ip: 10.250.0.10
    bridge:
      iface: vmbr9      # Host bridge interface for bridge-mode network tests

# ---------------------------------------------------------------------------
# Tier 2 — BOSH director deployment (required when tiers.bosh: true)
# ---------------------------------------------------------------------------
tier2:
  bosh_env_alias: pve           # Genesis environment alias (e.g. 'pve' or 'lab')
  deployment_name: emptyvm      # BOSH deployment to deploy during tier-2 tests
  deploy_timeout_s: 1800        # Seconds before deployment is considered hung

# ---------------------------------------------------------------------------
# Tier 3 — Cloud Foundry smoke tests (required when tiers.cf: true)
# ---------------------------------------------------------------------------
tier3:
  deployment_name: cf
  smoke_org: integration-smoke
  smoke_space: test
  smoke_app: httpbin-smoke
  smoke_timeout_s: 900
