#!/usr/bin/env bash
# OCFP ocfp-artifacts (RustFS S3) Provisioning Script
#
# Invoked by `ocfp artifacts provision` via:
#   scp scripts/provision/artifacts <user>@<artifacts>:/tmp/provision-artifacts.sh
#   ssh <user>@<artifacts> "... sudo bash /tmp/provision-artifacts.sh <envfile> ..."
#   (the SSH connection ProxyJumps through the bloc bastion)
#
# The artifacts VM boots bare on PVE 9.x — there is no snippets-capable storage
# to deliver the RustFS cloud-init, so RustFS is installed here, post-boot,
# instead. This is the SSH counterpart of internal/cpi/pve/cloudinit_artifacts.go
# and must stay in step with it.
#
# Argument $1: path to a root-readable env file (0600) sourced under `set -a`.
# Expected variables:
#   RUSTFS_ACCESS_KEY    S3 access key
#   RUSTFS_SECRET_KEY    S3 secret key
#   RUSTFS_S3_PORT       S3 API port (e.g. 9000)
#   RUSTFS_CONSOLE_PORT  web console port (e.g. 9001)
#   RUSTFS_VOLUMES       data mountpoint (e.g. /data)
#   RUSTFS_ZFS_DATASET   ZFS dataset (e.g. rpool/<bloc>)
#   RUSTFS_DOWNLOAD_URL  RustFS release zip URL
#   RUSTFS_TLS_ENABLED   "true" | "false"
#   RUSTFS_TLS_CERT      cert PEM (when TLS enabled)
#   RUSTFS_TLS_KEY       key PEM  (when TLS enabled)
#   ARTIFACTS_ENDPOINT   local endpoint for bucket creation (http(s)://127.0.0.1:<port>)
#   ARTIFACTS_BUCKETS    space-separated bucket names
#   OCFP_BLOC            bloc name (informational)
#
# Idempotent: every step is guarded so re-runs are safe.

set -euo pipefail

ENV_FILE="${1:-}"
if [[ -z "${ENV_FILE}" || ! -r "${ENV_FILE}" ]]; then
  echo "FATAL: env file argument missing or unreadable: '${ENV_FILE}'" >&2
  exit 1
fi

# Export every assignment so child processes (awscli) inherit the credentials.
set -a
# shellcheck disable=SC1090
. "${ENV_FILE}"
set +a

: "${RUSTFS_ACCESS_KEY:?RUSTFS_ACCESS_KEY required}"
: "${RUSTFS_SECRET_KEY:?RUSTFS_SECRET_KEY required}"
: "${RUSTFS_S3_PORT:=9000}"
: "${RUSTFS_CONSOLE_PORT:=9001}"
: "${RUSTFS_VOLUMES:=/data}"
: "${RUSTFS_ZFS_DATASET:?RUSTFS_ZFS_DATASET required}"
: "${RUSTFS_DOWNLOAD_URL:?RUSTFS_DOWNLOAD_URL required}"
: "${RUSTFS_TLS_ENABLED:=false}"
: "${ARTIFACTS_ENDPOINT:=http://127.0.0.1:${RUSTFS_S3_PORT}}"
: "${ARTIFACTS_BUCKETS:=}"

DATA_DEVICE="/dev/sdb"
ZPOOL="${RUSTFS_ZFS_DATASET%%/*}"
TLS_DIR="/opt/rustfs/tls"

log() { echo "==> $*"; }

log "OCFP artifacts provision starting (bloc=${OCFP_BLOC:-unknown})"

# ----------------------------------------------------------------------------
# 1. Packages
# ----------------------------------------------------------------------------
needed_pkgs=()
for pkg in zfsutils-linux unzip jq awscli; do
  dpkg -s "${pkg}" >/dev/null 2>&1 || needed_pkgs+=("${pkg}")
done
if [[ ${#needed_pkgs[@]} -gt 0 ]]; then
  log "Installing packages: ${needed_pkgs[*]}"
  export DEBIAN_FRONTEND=noninteractive
  apt-get update -y
  apt-get install -y "${needed_pkgs[@]}"
else
  log "All required packages already installed"
fi

# ----------------------------------------------------------------------------
# 2. rustfs system user
# ----------------------------------------------------------------------------
if ! id rustfs >/dev/null 2>&1; then
  log "Creating rustfs system user"
  useradd --system --home /var/lib/rustfs --shell /usr/sbin/nologin rustfs
else
  log "rustfs user already exists"
fi

# ----------------------------------------------------------------------------
# 3. ZFS pool + dataset on the attached data disk
# ----------------------------------------------------------------------------
zpool import -a 2>/dev/null || true
if ! zpool list "${ZPOOL}" >/dev/null 2>&1; then
  if [[ ! -b "${DATA_DEVICE}" ]]; then
    echo "FATAL: data device ${DATA_DEVICE} not present; is the data volume attached?" >&2
    exit 1
  fi
  log "Creating ZFS pool ${ZPOOL} on ${DATA_DEVICE}"
  zpool create -f -o ashift=12 "${ZPOOL}" "${DATA_DEVICE}"
else
  log "ZFS pool ${ZPOOL} already present"
fi

if ! zfs list "${RUSTFS_ZFS_DATASET}" >/dev/null 2>&1; then
  log "Creating ZFS dataset ${RUSTFS_ZFS_DATASET} at ${RUSTFS_VOLUMES}"
  zfs create -o "mountpoint=${RUSTFS_VOLUMES}" -o compression=lz4 "${RUSTFS_ZFS_DATASET}"
else
  log "ZFS dataset ${RUSTFS_ZFS_DATASET} already present"
fi

mkdir -p "${RUSTFS_VOLUMES}" "${TLS_DIR}" /var/log/rustfs
chown -R rustfs:rustfs "${RUSTFS_VOLUMES}" /opt/rustfs /var/log/rustfs

# ----------------------------------------------------------------------------
# 4. TLS material
# ----------------------------------------------------------------------------
if [[ "${RUSTFS_TLS_ENABLED}" == "true" ]]; then
  : "${RUSTFS_TLS_CERT:?RUSTFS_TLS_CERT required when TLS enabled}"
  : "${RUSTFS_TLS_KEY:?RUSTFS_TLS_KEY required when TLS enabled}"
  log "Writing TLS cert + key to ${TLS_DIR}"
  printf '%s\n' "${RUSTFS_TLS_CERT}" > "${TLS_DIR}/rustfs_cert.pem"
  printf '%s\n' "${RUSTFS_TLS_KEY}"  > "${TLS_DIR}/rustfs_key.pem"
  chown rustfs:rustfs "${TLS_DIR}/rustfs_cert.pem" "${TLS_DIR}/rustfs_key.pem"
  chmod 0640 "${TLS_DIR}/rustfs_cert.pem"
  chmod 0600 "${TLS_DIR}/rustfs_key.pem"
fi

# ----------------------------------------------------------------------------
# 5. /etc/default/rustfs
# ----------------------------------------------------------------------------
log "Writing /etc/default/rustfs"
{
  echo "RUSTFS_ADDRESS=:${RUSTFS_S3_PORT}"
  echo "RUSTFS_CONSOLE_ADDRESS=:${RUSTFS_CONSOLE_PORT}"
  echo "RUSTFS_ACCESS_KEY=${RUSTFS_ACCESS_KEY}"
  echo "RUSTFS_SECRET_KEY=${RUSTFS_SECRET_KEY}"
  echo "RUSTFS_VOLUMES=${RUSTFS_VOLUMES}"
  if [[ "${RUSTFS_TLS_ENABLED}" == "true" ]]; then
    echo "RUSTFS_TLS_PATH=${TLS_DIR}"
  fi
} > /etc/default/rustfs
chown rustfs:rustfs /etc/default/rustfs
chmod 0640 /etc/default/rustfs

# ----------------------------------------------------------------------------
# 6. systemd unit
# ----------------------------------------------------------------------------
log "Writing rustfs systemd unit"
cat > /etc/systemd/system/rustfs.service <<'UNIT'
[Unit]
Description=RustFS S3 server
After=network-online.target zfs-mount.service
Wants=network-online.target

[Service]
Type=simple
User=rustfs
Group=rustfs
EnvironmentFile=/etc/default/rustfs
ExecStart=/usr/local/bin/rustfs
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
UNIT

# ----------------------------------------------------------------------------
# 7. RustFS binary
# ----------------------------------------------------------------------------
if [[ ! -x /usr/local/bin/rustfs ]]; then
  log "Downloading RustFS from ${RUSTFS_DOWNLOAD_URL}"
  curl -fsSL "${RUSTFS_DOWNLOAD_URL}" -o /tmp/rustfs.zip
  unzip -o -d /usr/local/bin /tmp/rustfs.zip
  chmod +x /usr/local/bin/rustfs
  rm -f /tmp/rustfs.zip
else
  log "RustFS binary already installed"
fi

# ----------------------------------------------------------------------------
# 8. Start the service
# ----------------------------------------------------------------------------
log "Enabling and (re)starting rustfs"
systemctl daemon-reload
systemctl enable rustfs
systemctl restart rustfs

# ----------------------------------------------------------------------------
# 9. Wait for readiness
# ----------------------------------------------------------------------------
log "Waiting for RustFS to listen on ${ARTIFACTS_ENDPOINT}"
ready=false
for _ in $(seq 1 30); do
  if curl -fsS -k -o /dev/null --max-time 3 "${ARTIFACTS_ENDPOINT}/" 2>/dev/null \
     || curl -s -k -o /dev/null --max-time 3 "${ARTIFACTS_ENDPOINT}/" 2>/dev/null; then
    ready=true
    break
  fi
  sleep 2
done
if [[ "${ready}" != "true" ]]; then
  echo "WARNING: RustFS did not answer on ${ARTIFACTS_ENDPOINT} within timeout" >&2
  systemctl --no-pager status rustfs || true
  journalctl -u rustfs --no-pager -n 30 || true
  exit 1
fi
log "RustFS is responding"

# ----------------------------------------------------------------------------
# 10. Buckets (idempotent)
# ----------------------------------------------------------------------------
export AWS_ACCESS_KEY_ID="${RUSTFS_ACCESS_KEY}"
export AWS_SECRET_ACCESS_KEY="${RUSTFS_SECRET_KEY}"
export AWS_DEFAULT_REGION="${AWS_DEFAULT_REGION:-us-east-1}"

aws_args=(--endpoint-url "${ARTIFACTS_ENDPOINT}")
if [[ "${RUSTFS_TLS_ENABLED}" == "true" ]]; then
  aws_args+=(--no-verify-ssl)
fi

for bucket in ${ARTIFACTS_BUCKETS}; do
  if aws "${aws_args[@]}" s3api head-bucket --bucket "${bucket}" >/dev/null 2>&1; then
    log "Bucket already exists: ${bucket}"
  else
    log "Creating bucket: ${bucket}"
    aws "${aws_args[@]}" s3 mb "s3://${bucket}" >/dev/null 2>&1 || {
      echo "WARNING: failed to create bucket ${bucket}" >&2
    }
  fi
done

log "OCFP artifacts provision complete"
